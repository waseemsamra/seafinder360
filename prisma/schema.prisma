generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Yacht {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  guests      Int
  length      Int
  cabins      Int
  location    String
  price       Int?
  minHours    Int      @default(3)
  marina      String
  img         String
  isF1        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
